# ─────────────────────────────────────────────────────────────────────
#  Contact form configuration (server-side only — NEVER prefix with NEXT_PUBLIC)
#
#  Copy this file to `.env.local` and fill in what you need.
#  The site works with NONE of these set: the form then hands a
#  pre-filled draft to the visitor's email app instead.
# ─────────────────────────────────────────────────────────────────────

# URL that receives contact submissions (Formspree, Web3Forms, Resend
# inbound, your own API…). POSTed as JSON: { name, email, message }.
CONTACT_ENDPOINT=

# Optional bearer token forwarded as `Authorization: Bearer …`.
CONTACT_API_KEY=
